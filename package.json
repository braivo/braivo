{
  "name": "braivo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "predev": "bun run --silent --cwd apps/server check",
    "dev": "vp run --parallel --filter '@braivo/*' --filter '!@braivo/storybook' dev",
    "dev:demo": "bun tooling/dev-demo/cli.ts",
    "dev:demo:verify": "bun tooling/dev-demo/cli.ts verify",
    "dev:demo:reset": "bun tooling/dev-demo/cli.ts reset",
    "storybook": "vp run @braivo/storybook#dev",
    "build": "vp run -r build",
    "test": "bun --env-file=.env.local --bun vp test",
    "db:generate": "vp run @braivo/db#generate",
    "db:migrate": "bun apps/server/cli/index.ts db migrate",
    "serve": "bun --no-env-file apps/server/cli/index.ts serve",
    "prepare": "vp config --no-agent",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync --clean && lingui check missing --mode catalog",
    "docs:check": "bun tooling/docs-check.ts",
    "license:check": "uvx --from 'reuse[charset-normalizer]' reuse lint",
    "cla:check": "bun tooling/cla.ts"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@lingui/conf": "catalog:",
    "@lingui/format-po": "catalog:",
    "@lingui/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "pg": "catalog:",
    "playwright": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@better-auth/cimd": "1.7.11",
    "@better-auth/core": "1.7.11",
    "@better-auth/drizzle-adapter": "1.7.11",
    "@better-auth/mcp": "1.7.11",
    "@lingui/cli": "6.10.0",
    "@lingui/conf": "6.10.0",
    "@lingui/core": "6.10.0",
    "@lingui/format-po": "6.10.0",
    "@lingui/react": "6.10.0",
    "@lingui/vite-plugin": "6.10.0",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "auth": "1.7.11",
    "better-auth": "1.7.11",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  }
}
