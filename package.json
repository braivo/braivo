{
  "name": "braivo",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter '@braivo/*' --filter '!@braivo/storybook' dev",
    "dev:demo": "bun tooling/dev-demo/cli.ts",
    "dev:demo:verify": "bun tooling/dev-demo/cli.ts verify",
    "dev:demo:reset": "bun tooling/dev-demo/cli.ts reset",
    "storybook": "vp run @braivo/storybook#dev",
    "build": "vp run -r build",
    "test": "bun --bun vp test",
    "db:generate": "vp run @braivo/db#generate",
    "db:migrate": "bun apps/server/cli/index.ts db migrate",
    "serve": "bun apps/server/cli/index.ts serve",
    "prepare": "vp config --no-agent",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync --clean && lingui check missing --mode catalog",
    "docs:check": "bun tooling/docs-check.ts",
    "license:check": "uvx --from 'reuse[charset-normalizer]' reuse lint",
    "cla:check": "bun tooling/cla.ts"
  },
  "devDependencies": {
    "@lingui/cli": "6.10.0",
    "@lingui/conf": "6.10.0",
    "@lingui/format-po": "6.10.0",
    "@lingui/vite-plugin": "6.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/browser-playwright": "catalog:",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@types/bun": "1.4.3",
    "@vitest/browser-playwright": "5.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  }
}
