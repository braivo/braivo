{
  "name": "@braivo/server",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./server.ts",
    "./client": "./api/client.ts"
  },
  "scripts": {
    "dev": "bun --watch --env-file=../../.env cli/index.ts serve",
    "build": "bun build --compile cli/index.ts --outfile dist/braivo",
    "auth:generate": "bun --bun better-auth generate --config better-auth.config.ts --output ../../packages/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@braivo/db": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "nodemailer": "^8.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "auth": "1.7.5"
  }
}
