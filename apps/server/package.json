{
  "name": "@braivo/server",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./server.ts",
    "./client": "./api/client.ts",
    "./content": "./content/index.ts",
    "./testing": "./testing.ts"
  },
  "scripts": {
    "dev": "bun --watch --env-file=../../.env --env-file=../../.env.development --env-file=../../.env.local --env-file=../../.env.development.local cli/index.ts serve",
    "check": "bun --env-file=../../.env --env-file=../../.env.development --env-file=../../.env.local --env-file=../../.env.development.local cli/index.ts config check",
    "auth:generate": "bun --bun better-auth generate --config better-auth.config.ts --output ../../packages/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@braivo/db": "workspace:*",
    "@braivo/i18n": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.13",
    "jose": "6.2.12",
    "nodemailer": "^10.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "auth": "catalog:",
    "vite-plus": "catalog:"
  }
}
