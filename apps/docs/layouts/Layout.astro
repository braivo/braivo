import { ClientRouter } from "astro:transitions";

import "../styles.css";

interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Braivo</title>
    <!-- Under docs/, as a shared host's root is another site's. -->
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}docs/favicon.svg`} type="image/svg+xml" />
    {description && <meta name="description" content={description} />}
    <ClientRouter />
    <!-- Opens the question a URL's hash names (Accordion, components/mdx.tsx). -->
    <script is:inline>
      function openTarget() {
        let id;
        try {
          id = decodeURIComponent(location.hash.slice(1));
        } catch {
          return; // A malformed link names nothing.
        }
        const target = document.getElementById(id);
        if (!(target instanceof HTMLDetailsElement)) return;
        target.open = true;
        // The router can restore the top after the browser's own hash scroll.
        target.scrollIntoView({ block: "start" });
      }
      addEventListener("hashchange", openTarget);
      addEventListener("popstate", openTarget);
      document.addEventListener("astro:page-load", openTarget);
      // The router takes a same-page link's hash without a hashchange.
      document.addEventListener("click", (event) => {
        const link = event.target instanceof Element && event.target.closest(".accordion-link");
        if (link) link.closest("details").open = true;
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
  </body>
</html>
