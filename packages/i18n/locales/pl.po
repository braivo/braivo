msgid "That did not work. Try again."
msgstr "Nie udało się. Spróbuj ponownie."

#: apps/console/routes/login.tsx
msgid "This account is not a member of {organizationName}. Ask to be added, then try again."
msgstr "To konto nie należy do organizacji „{organizationName}”. Poproś o dodanie, a potem spróbuj ponownie."

#: apps/learn/routes/login.tsx
msgid "This sign-in did not finish."
msgstr "To logowanie nie zostało dokończone."

#: apps/console/routes/login.tsx
msgid "This sign-in has expired"
msgstr "To logowanie wygasło"

#: packages/auth-client/sign-in.tsx
msgid "Too many tries. Wait a minute, then try again."
msgstr "Zbyt wiele prób. Poczekaj minutę i spróbuj ponownie."

#: apps/console/router.tsx
