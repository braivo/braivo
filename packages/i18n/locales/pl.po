msgstr "Użyj innego konta"

#: packages/ui/compositions/sign-in-form.tsx
msgid "Use another email"
msgstr "Użyj innego adresu e-mail"

#: apps/console/routes/login.tsx
#: packages/auth-client/sign-in.tsx
msgid "You were signed out. Sign in again."
msgstr "Wylogowano Cię. Zaloguj się ponownie."

#: apps/console/routes/login.tsx
msgid "You will continue at {hostname}."
msgstr "Potem przejdziesz na stronę {hostname}."

#: packages/auth-client/sign-in.tsx
msgid "Your Google account's email is not verified. Sign in with a code instead."
msgstr "Adres e-mail Twojego konta Google nie jest zweryfikowany. Zaloguj się kodem."

#: packages/auth-client/sign-in.tsx
msgid "Your Google account's email no longer matches this account. Sign in with a code to the account's email."
msgstr "Adres e-mail Twojego konta Google nie zgadza się już z tym kontem. Zaloguj się kodem wysłanym na adres e-mail tego konta."

#: packages/ui/compositions/sign-in-form.tsx
