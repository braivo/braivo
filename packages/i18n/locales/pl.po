#: packages/auth-client/sign-in.tsx
msgid "A code was just sent to this address. Wait a minute before asking again."
msgstr "Kod został właśnie wysłany na ten adres. Poczekaj minutę, zanim poprosisz o kolejny."

#: packages/ui/compositions/sign-in-form.tsx
msgid "A new code was sent to {email}. Check your spam folder too."
msgstr "Nowy kod został wysłany na adres {email}. Sprawdź też folder ze spamem."

