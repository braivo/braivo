msgid "Go back to the site you came from and sign in again."
msgstr "Wróć do poprzedniej strony i zaloguj się ponownie."

#: packages/ui/compositions/sign-in-form.tsx
msgid "How others in your organizations see you."
msgstr "Tak widzą Cię inni w Twoich organizacjach."

#: apps/learn/routes/login.tsx
