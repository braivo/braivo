# Development defaults, committed, so no secrets: Bun loads this file unless
# NODE_ENV says otherwise, Vite in development mode, and `bun run serve` never
# (docs/adr/0051-environment-files.md).
# Your own values go in .env.local, which every worktree copies; BRAIVO_URL and
# ports in .env.development.local, since Vite, unlike Bun, ranks this file above
# .env.local.

DATABASE_URL=postgres://localhost/braivo
BRAIVO_URL=http://localhost:5174

# In .env.local:
# BETTER_AUTH_SECRET=   required: openssl rand -base64 32
# TEST_DATABASE_URL=    postgres://localhost/braivo_test; the database suites skip without it
# ANTHROPIC_API_KEY=    optional, Braivo's AI: a development key with a spend limit
# GOOGLE_CLIENT_ID= and GOOGLE_CLIENT_SECRET=   optional, "Continue with Google"
